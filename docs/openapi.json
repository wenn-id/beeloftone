  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MovementCreate": {
        "properties": {
          "line_id": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Line Id"
          },
          "from_stage": {
            "type": "string",
            "enum": [
              "planned",
              "cutting",
              "sewing",
              "finishing",
              "qc",
              "rework",
              "reject",
              "warehouse"
            ],
            "title": "From Stage"
          },
          "to_stage": {
            "type": "string",
            "enum": [
              "planned",
              "cutting",
              "sewing",
              "finishing",
              "qc",
              "rework",
              "reject",
              "warehouse"
            ],
            "title": "To Stage"
          },
          "quantity": {
            "type": "integer",
            "maximum": 1000000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Quantity"
          },
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "title": "Reason",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "line_id",
          "from_stage",
          "to_stage",
          "quantity"
        ],
        "title": "MovementCreate"
      },
      "OrderCreate": {
        "properties": {
          "reference": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Reference"
          },
          "title": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Title"
          },
          "owner_id": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Owner Id"
          },
          "due_date": {
            "type": "string",
            "format": "date",
            "title": "Due Date"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/OrderLine"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Lines"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "reference",
          "title",
          "owner_id",
          "due_date",
          "lines"
        ],
        "title": "OrderCreate"
      },
      "OrderLine": {
        "properties": {
          "product_id": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Product Id"
          },
          "quantity": {
            "type": "integer",
            "maximum": 1000000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Quantity"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "product_id",
          "quantity"
        ],
        "title": "OrderLine"
      },
      "ProductCreate": {
        "properties": {
          "sku": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Sku"
          },
          "name": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Name"
          },
          "color": {
            "type": "string",
            "maxLength": 80,
            "title": "Color",
            "default": ""
          },
          "size": {
            "type": "string",
            "maxLength": 40,
            "title": "Size",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sku",
          "name"
        ],
        "title": "ProductCreate"
      },
      "ReversalCreate": {
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "reason"
        ],
        "title": "ReversalCreate"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
